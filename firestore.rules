rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Fonctions d'aide à la sécurité
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isStaff() {
      return isAuthenticated() &&
        (request.auth.token.role in ['admin', 'teacher'] ||
         request.auth.token.admin == true);
    }

    // 1. Collection USERS : Gestion des profils et sécurisation des rôles/points
    match /users/{userId} {
      // Lecture autorisée pour tout utilisateur connecté (pour le classement et profil)
      allow read: if isAuthenticated();

      // Création initiale avec valeurs de sécurité par défaut strictes
      allow create: if isOwner(userId)
        && request.resource.data.role == 'student'
        && request.resource.data.totalPoints == 0
        && request.resource.data.level == 1;

      // Mise à jour de profil par l'apprenant : interdiction formelle d'altérer les privilèges ou les scores
      allow update: if isOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status', 'totalPoints', 'level', 'email'])
        || isStaff();

      allow delete: if isStaff();

      // Sous-collection des tests passés par l'apprenant (/users/{userId}/tests/{testId})
      match /tests/{testSubmissionId} {
        allow read: if isOwner(userId) || isStaff();
        allow create: if isOwner(userId);
        allow update, delete: if isStaff();
      }
    }

    // 2. Collection TESTS : Examens et évaluations
    match /tests/{testId} {
      allow read: if isAuthenticated();
      allow write: if isStaff();
    }

    // 3. Collection ANNOUNCEMENTS : Annonces et notifications
    match /announcements/{announcementId} {
      allow read: if isAuthenticated();
      allow write: if isStaff();
    }

    // 4. Collection PROGRAMS : Planning et sessions directes Meet
    match /programs/{programId} {
      allow read: if isAuthenticated();
      allow write: if isStaff();
    }

    // 5. Collection CONFIG : Données sensibles (emails participants, tokens)
    match /config/{configDoc} {
      allow read, write: if isStaff();
    }
  }
}
